{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "prefix": "app",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/web",
        "index": "apps/web/src/index.html",
        "main": "apps/web/src/main.ts",
        "polyfills": [
          "zone.js",
          "./node_modules/@webcomponents/webcomponentsjs/webcomponents-loader.js",
          "./node_modules/@webcomponents/webcomponentsjs/custom-elements-es5-adapter.js"
        ],
        "tsConfig": "apps/web/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/web/src/assets",
          {
            "glob": "icons.svg",
            "input": "libs/design-system/src/assets",
            "output": "./assets/design-system"
          },
          {
            "glob": "**/*",
            "input": "shared/assets",
            "output": "./assets"
          },
          {
            "glob": "**/*",
            "input": "libs/feature/webcomponent/src/lib/docs/playground",
            "output": "/assets/playground/exercises"
          },
          {
            "glob": "**/*",
            "input": "./node_modules/@ant-design/icons-angular/src/inline-svg/",
            "output": "/assets/vendors/@ant-design/assets/"
          },
          {
            "glob": "**/*",
            "input": "./node_modules/@cisstech/nge/assets/monaco",
            "output": "./assets/vendors/nge/monaco/"
          },
          {
            "glob": "**/*",
            "input": "./node_modules/@cisstech/nge/assets/markdown/",
            "output": "./assets/vendors/nge/markdown/"
          },
          {
            "glob": "**/*",
            "input": "./node_modules/@cisstech/nge/assets/ui/icon/assets/icons/files",
            "output": "./assets/vendors/nge/ui/icon/icons/files/"
          },
          {
            "glob": "**/*",
            "input": "./node_modules/monaco-editor/min",
            "output": "./assets/vendors/nge/monaco/min"
          },
          {
            "glob": "**/*",
            "input": "./node_modules/monaco-editor/min-maps",
            "output": "./assets/vendors/nge/monaco/min-maps"
          },
          {
            "glob": "**/*",
            "input": "./node_modules/katex/dist/",
            "output": "./assets/vendors/katex/"
          },
          {
            "glob": "**/*",
            "input": "./node_modules/katex/dist/",
            "output": "./assets/vendors/katex/dist/"
          },
          {
            "glob": "**/*.js",
            "input": "./node_modules/emoji-toolkit/lib/js/",
            "output": "./assets/vendors/emoji-toolkit/"
          },
          {
            "glob": "**/*",
            "input": "./node_modules/intro.js/",
            "output": "./assets/vendors/intro.js/"
          },
          {
            "glob": "**/*.js",
            "input": "./node_modules/viz.js/",
            "output": "./assets/vendors/viz/"
          },
          {
            "glob": "**/*",
            "input": "./node_modules/jsplumb/dist/",
            "output": "./assets/vendors/jsplumb/"
          },
          {
            "glob": "**/*",
            "input": "./node_modules/jsplumb/css/",
            "output": "./assets/vendors/jsplumb/css/"
          },
          {
            "glob": "**/*.{js,css,map,mjs}",
            "input": "./node_modules/jsxgraph/distrib/",
            "output": "./assets/vendors/jsxgraph/"
          },
          {
            "glob": "**/*",
            "input": "./node_modules/mathlive/dist/",
            "output": "./assets/vendors/mathlive/"
          },
          {
            "glob": "**/*",
            "input": "./node_modules/jsoneditor/dist/",
            "output": "./assets/vendors/jsoneditor/"
          },
          {
            "glob": "**/*",
            "input": "./node_modules/reveal.js/dist/",
            "output": "./assets/vendors/revealjs/"
          },
          {
            "glob": "**/*",
            "input": "./node_modules/reveal.js/plugin/",
            "output": "./assets/vendors/revealjs/plugin/"
          },
          {
            "glob": "**/*",
            "input": "./node_modules/d3/dist/",
            "output": "./assets/vendors/d3/"
          },
          {
            "glob": "**/*",
            "input": "./node_modules/d3-graphviz/build/",
            "output": "./assets/vendors/d3-graphviz/"
          },
          {
            "glob": "*.css",
            "input": "./node_modules/highlight.js/styles/",
            "output": "./assets/vendors/highlight.js/styles/"
          }
        ],
        "styles": [
          {
            "input": "shared/styles/app.scss",
            "bundleName": "styles.legacy",
            "inject": false
          },
          {
            "input": "apps/web/src/styles.scss",
            "bundleName": "styles.legacy",
            "inject": false
          },
          {
            "input": "libs/design-system/src/styles/next.scss",
            "bundleName": "styles.next",
            "inject": false
          },
          {
            "input": "shared/styles/material/dark.scss",
            "bundleName": "styles.material.dark",
            "inject": false
          },
          {
            "input": "shared/styles/material/light.scss",
            "bundleName": "styles.material.light",
            "inject": false
          },
          {
            "input": "shared/styles/ng-zorro/dark.less",
            "bundleName": "styles.ng-zorro.dark",
            "inject": false
          },
          {
            "input": "shared/styles/ng-zorro/light.less",
            "bundleName": "styles.ng-zorro.light",
            "inject": false
          }
        ],
        "scripts": [],
        "allowedCommonJsDependencies": [
          "jsplumb",
          "subscriptions-transport-ws",
          "rfdc",
          "jsoneditor",
          "@ts-jison/lexer",
          "@ts-jison/parser",
          "@editorjs/editorjs",
          "@editorjs/code",
          "@editorjs/delimiter",
          "@editorjs/simple-image",
          "@editorjs/checklist",
          "@editorjs/nested-list",
          "@editorjs/raw",
          "@editorjs/table",
          "@editorjs/header",
          "@editorjs/marker",
          "@editorjs/paragraph",
          "@editorjs/text-variant-tune",
          "@editorjs/underline",
          "editorjs-drag-drop",
          "editorjs-undo",
          "editorjs-style",
          "editorjs-text-alignment-blocktune",
          "editorjs-text-color-plugin",
          "pdfjs-dist/build/pdf.worker.entry",
          "crypto-js"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "6mb",
              "maximumError": "12mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "14kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      }
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "defaultConfiguration": "development",
      "continuous": true,
      "options": {
        "host": "0.0.0.0",
        "port": 4200
      },
      "configurations": {
        "production": {
          "buildTarget": "web:build:production"
        },
        "development": {
          "buildTarget": "web:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "web:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/web/jest.config.ts",
        "tsConfig": "apps/web/tsconfig.spec.json"
      }
    }
  }
}
