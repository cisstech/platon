{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": false,
    "noImplicitOverride": false,
    "esModuleInterop": true,
    "allowJs": true,
    "paths": {
      "@platon/cli": ["./tools/cli/src/index.ts"],
      "@platon/design-system": ["./libs/design-system/src/index.ts"],
      "@platon/core/browser": ["./libs/core/browser/src/index.ts"],
      "@platon/core/browser/shared": ["./libs/core/browser/src/shared.ts"],
      "@platon/core/common": ["./libs/core/common/src/index.ts"],
      "@platon/core/server": ["./libs/core/server/src/index.ts"],
      "@platon/core/testing/common": ["./libs/core/testing/common/src/index.ts"],
      "@platon/core/testing/e2e-server": ["./libs/core/testing/e2e-server/src/index.ts"],
      "@platon/core/testing/server": ["./libs/core/testing/server/src/index.ts"],
      "@platon/feature/ai/browser": ["./libs/feature/ai/browser/src/index.ts"],
      "@platon/feature/ai/common": ["./libs/feature/ai/common/src/index.ts"],
      "@platon/feature/ai/server": ["./libs/feature/ai/server/src/index.ts"],
      "@platon/feature/announcement/browser": ["./libs/feature/announcement/browser/src/index.ts"],
      "@platon/feature/announcement/common": ["./libs/feature/announcement/common/src/index.ts"],
      "@platon/feature/announcement/server": ["./libs/feature/announcement/server/src/index.ts"],
      "@platon/feature/builder/browser": ["./libs/feature/builder/browser/src/index.ts"],
      "@platon/feature/builder/common": ["./libs/feature/builder/common/src/index.ts"],
      "@platon/feature/builder/server": ["./libs/feature/builder/server/src/index.ts"],
      "@platon/feature/cas/browser": ["./libs/feature/cas/browser/src/index.ts"],
      "@platon/feature/cas/common": ["./libs/feature/cas/common/src/index.ts"],
      "@platon/feature/cas/server": ["./libs/feature/cas/server/src/index.ts"],
      "@platon/feature/compiler": ["./libs/feature/compiler/src/index.ts"],
      "@platon/feature/course/browser": ["./libs/feature/course/browser/src/index.ts"],
      "@platon/feature/course/common": ["./libs/feature/course/common/src/index.ts"],
      "@platon/feature/course/server": ["./libs/feature/course/server/src/index.ts"],
      "@platon/feature/discord/browser": ["./libs/feature/discord/browser/src/index.ts"],
      "@platon/feature/discord/common": ["./libs/feature/discord/common/src/index.ts"],
      "@platon/feature/discord/server": ["./libs/feature/discord/server/src/index.ts"],
      "@platon/feature/email/server": ["./libs/feature/email/server/src/index.ts"],
      "@platon/feature/lti/browser": ["./libs/feature/lti/browser/src/index.ts"],
      "@platon/feature/lti/common": ["./libs/feature/lti/common/src/index.ts"],
      "@platon/feature/lti/server": ["./libs/feature/lti/server/src/index.ts"],
      "@platon/feature/notification/browser": ["./libs/feature/notification/browser/src/index.ts"],
      "@platon/feature/notification/common": ["./libs/feature/notification/common/src/index.ts"],
      "@platon/feature/notification/server": ["./libs/feature/notification/server/src/index.ts"],
      "@platon/feature/peer/browser": ["./libs/feature/peer/browser/src/index.ts"],
      "@platon/feature/peer/common": ["./libs/feature/peer/common/src/index.ts"],
      "@platon/feature/peer/server": ["./libs/feature/peer/server/src/index.ts"],
      "@platon/feature/player/browser": ["./libs/feature/player/browser/src/index.ts"],
      "@platon/feature/player/common": ["./libs/feature/player/common/src/index.ts"],
      "@platon/feature/player/server": ["./libs/feature/player/server/src/index.ts"],
      "@platon/feature/resource/browser": ["./libs/feature/resource/browser/src/index.ts"],
      "@platon/feature/resource/common": ["./libs/feature/resource/common/src/index.ts"],
      "@platon/feature/resource/server": ["./libs/feature/resource/server/src/index.ts"],
      "@platon/feature/result/browser": ["./libs/feature/result/browser/src/index.ts"],
      "@platon/feature/result/common": ["./libs/feature/result/common/src/index.ts"],
      "@platon/feature/result/server": ["./libs/feature/result/server/src/index.ts"],
      "@platon/feature/tests/browser": ["./libs/feature/tests/browser/src/index.ts"],
      "@platon/feature/tests/common": ["./libs/feature/tests/common/src/index.ts"],
      "@platon/feature/tests/server": ["./libs/feature/tests/server/src/index.ts"],
      "@platon/feature/tuto/browser": ["./libs/feature/tuto/browser/src/index.ts"],
      "@platon/feature/webcomponent": ["./libs/feature/webcomponent/src/index.ts"],
      "@platon/graphql": ["./.graphql/types.ts"],
      "@platon/shared/server": ["./libs/shared/server/src/index.ts"],
      "@platon/shared/ui": ["./libs/shared/ui/src/index.ts"],
      "@platon/shared/utils": ["./libs/shared/utils/src/index.ts"],
      "utils": ["./libs/shared/utils/src/index.ts"]
    },
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "ignoreDeprecations": "6.0"
  },
  "files": ["types/index.d.ts"],
  "include": ["./.graphql/*.ts"],
  "exclude": ["node_modules", "tmp"],
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
