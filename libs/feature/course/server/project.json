{
  "name": "feature-course-server",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/feature/course/server/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/feature/course/server/jest.config.ts"
      }
    },
    "test:integration": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}/integration"],
      "options": {
        "jestConfig": "libs/feature/course/server/jest.integration.config.ts",
        "passWithNoTests": false
      }
    },
    "test:e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}/e2e"],
      "options": {
        "jestConfig": "libs/feature/course/server/jest.e2e.config.ts",
        "passWithNoTests": false
      }
    },
    "test:all": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run feature-course-server:test",
          "nx run feature-course-server:test:integration",
          "nx run feature-course-server:test:e2e"
        ],
        "parallel": false
      }
    }
  }
}
