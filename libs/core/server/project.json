{
  "name": "core-server",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/core/server/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:core", "target:server"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/core/server/jest.config.ts"
      }
    },
    "test:integration": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}/integration"],
      "options": {
        "jestConfig": "libs/core/server/jest.integration.config.ts",
        "passWithNoTests": false
      }
    },
    "test:all": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["nx run core-server:test", "nx run core-server:test:integration"],
        "parallel": false
      }
    }
  }
}
