{
  "name": "design-system",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/design-system/src",
  "prefix": "pl",
  "tags": ["scope:design-system"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/design-system/jest.config.ts",
        "tsConfig": "libs/design-system/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "icons": {
      "command": "node libs/design-system/scripts/icon-sprite.mjs"
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 6006,
        "configDir": "libs/design-system/.storybook",
        "browserTarget": "design-system:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "outputDir": "dist/storybook/design-system",
        "configDir": "libs/design-system/.storybook",
        "browserTarget": "design-system:build-storybook",
        "tsConfig": "libs/design-system/.storybook/tsconfig.json",
        "styles": ["libs/design-system/src/styles/next.scss", "libs/design-system/.storybook/stories.scss"],
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    }
  }
}
